<UserControl x:Class="DsxLite.App.TriggerEffectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ComboBox x:Name="ModeCombo" SelectionChanged="OnModeChanged"/>
        <StackPanel x:Name="ParamsPanel" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{DynamicResource Apply}" Width="80" Click="OnApplyClicked"/>
            <Button Content="{DynamicResource EffectOff}" Width="80" Margin="8,0,0,0" Click="OnOffClicked"/>
        </StackPanel>
    </StackPanel>
</UserControl>
