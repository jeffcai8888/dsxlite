<UserControl x:Class="DsxLite.App.TriggerEffectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ComboBox x:Name="ModeCombo" SelectionChanged="OnModeChanged"/>
        <StackPanel x:Name="ParamsPanel" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="应用" Width="72" Click="OnApplyClicked"/>
            <Button Content="关闭效果" Width="72" Margin="8,0,0,0" Click="OnOffClicked"/>
        </StackPanel>
    </StackPanel>
</UserControl>
