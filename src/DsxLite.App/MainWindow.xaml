<Window x:Class="DsxLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DsxLite.App"
        Title="DsxLite — DualSense PC 工具"
        Width="1060" Height="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 设备栏 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="DeviceList" Margin="0,0,8,0" MaxHeight="110" SelectionChanged="OnDeviceSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="380">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Foreground="Gray" Margin="8,0"/>
                            <Button Grid.Column="2" Content="{Binding Action}" Tag="{Binding}" Padding="10,2" Click="OnDeviceRowAction"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="{DynamicResource Refresh}" Width="80" Margin="0,0,8,0" Click="OnRefreshClicked"/>
            <ComboBox x:Name="LanguageCombo" Grid.Column="2" Width="110" Margin="0,0,8,0" SelectionChanged="OnLanguageChanged"/>
            <TextBlock x:Name="BatteryText" Grid.Column="3" VerticalAlignment="Center" Text=""/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 输入可视化 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                <StackPanel>
                    <GroupBox Header="{DynamicResource GroupSticks}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="LeftStickCanvas" Width="110" Height="110" Margin="4">
                                <Border Width="110" Height="110" BorderBrush="Gray" BorderThickness="1" CornerRadius="55"/>
                                <Ellipse x:Name="LeftStickDot" Width="16" Height="16" Fill="#FF3B8ED0"/>
                            </Canvas>
                            <Canvas x:Name="RightStickCanvas" Width="110" Height="110" Grid.Column="1" Margin="4">
                                <Border Width="110" Height="110" BorderBrush="Gray" BorderThickness="1" CornerRadius="55"/>
                                <Ellipse x:Name="RightStickDot" Width="16" Height="16" Fill="#FF3B8ED0"/>
                            </Canvas>
                            <StackPanel Grid.Column="2" Margin="12,4,4,4" VerticalAlignment="Center">
                                <TextBlock Text="L2"/>
                                <ProgressBar x:Name="L2Bar" Minimum="0" Maximum="255" Height="12"/>
                                <TextBlock Text="R2" Margin="0,8,0,0"/>
                                <ProgressBar x:Name="R2Bar" Minimum="0" Maximum="255" Height="12"/>
                                <TextBlock x:Name="MotionText" Margin="0,12,0,0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupButtons}" Padding="8" Margin="0,8,0,0">
                        <WrapPanel x:Name="ButtonsPanel"/>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupTouchpad}" Padding="8" Margin="0,8,0,0">
                        <Canvas x:Name="TouchCanvas" Width="320" Height="180" HorizontalAlignment="Left">
                            <Border Width="320" Height="180" BorderBrush="Gray" BorderThickness="1" CornerRadius="6"/>
                            <Ellipse x:Name="TouchDot1" Width="12" Height="12" Fill="#FF3B8ED0" Visibility="Collapsed"/>
                            <Ellipse x:Name="TouchDot2" Width="12" Height="12" Fill="#FF50A050" Visibility="Collapsed"/>
                        </Canvas>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 输出控制 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="6,0,0,0">
                <StackPanel>
                    <GroupBox x:Name="RumbleGroup" Header="{DynamicResource GroupRumble}" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource MotorLarge}"/>
                            <Slider x:Name="RumbleLeft" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnRumbleChanged"/>
                            <TextBlock Text="{DynamicResource MotorSmall}" Margin="0,4,0,0"/>
                            <Slider x:Name="RumbleRight" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnRumbleChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupLightbar}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle x:Name="LightbarPreview" Width="48" Height="24" RadiusX="4" RadiusY="4" Fill="Black" Stroke="Gray" VerticalAlignment="Center"/>
                                <CheckBox x:Name="LightbarOffCheck" Content="{DynamicResource LightbarOff}" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OnLightbarSetupChanged" Unchecked="OnLightbarSetupChanged"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Red}" Margin="0,6,0,0"/>
                            <Slider x:Name="LightR" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnLightbarChanged"/>
                            <TextBlock Text="{DynamicResource Green}"/>
                            <Slider x:Name="LightG" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnLightbarChanged"/>
                            <TextBlock Text="{DynamicResource Blue}"/>
                            <Slider x:Name="LightB" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnLightbarChanged"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupLeds}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <WrapPanel x:Name="PlayerLedsPanel"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource MuteLed}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MuteLedCombo" Width="110" Margin="8,0,0,0" SelectionChanged="OnMuteLedChanged">
                                    <ComboBoxItem Content="{DynamicResource Off}"/>
                                    <ComboBoxItem Content="{DynamicResource On}"/>
                                    <ComboBoxItem Content="{DynamicResource Pulsing}"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupTriggerTest}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <ListBox x:Name="TriggerTestList" Height="190" SelectionChanged="OnTriggerTestSelected">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Hint}" Foreground="Gray" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Content="{DynamicResource ResetTriggers}" Margin="0,8,0,0" Click="OnTriggerTestReset"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupTriggerL2}" Padding="8" Margin="0,8,0,0">
                        <local:TriggerEffectControl x:Name="LeftTriggerControl" EffectRequested="OnLeftTriggerEffect"/>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupTriggerR2}" Padding="8" Margin="0,8,0,0">
                        <local:TriggerEffectControl x:Name="RightTriggerControl" EffectRequested="OnRightTriggerEffect"/>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupHaptics}" Padding="8" Margin="0,8,0,0">
                        <StackPanel x:Name="HapticsPanel">
                            <TextBlock x:Name="HapticsStatus" TextWrapping="Wrap" Foreground="Gray" Text="{DynamicResource HapticsNeedUsb}"/>
                            <CheckBox x:Name="HapticsEnable" Content="{DynamicResource EnableHaptics}" Margin="0,6,0,0" Checked="OnHapticsChecked" Unchecked="OnHapticsUnchecked"/>
                            <TextBlock Text="{DynamicResource PulseDecay}" Margin="0,6,0,0"/>
                            <Slider x:Name="HapticsPulseDecay" Minimum="50" Maximum="500" Value="150" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnHapticsPulseDecayChanged"/>
                            <Grid x:Name="HapticsManualGrid" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="{DynamicResource MotorLeft}" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="HapticsLeftWave" Margin="0,4,0,0" SelectionChanged="OnHapticsSettingsChanged">
                                        <ComboBoxItem Content="{DynamicResource WaveSine}"/>
                                        <ComboBoxItem Content="{DynamicResource WaveSquare}"/>
                                        <ComboBoxItem Content="{DynamicResource WavePulse}"/>
                                        <ComboBoxItem Content="{DynamicResource WaveNoise}"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource FrequencyHz}"/>
                                    <Slider x:Name="HapticsLeftFreq" Minimum="20" Maximum="500" Value="80" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnHapticsSettingsChanged"/>
                                    <TextBlock Text="{DynamicResource AmplitudePct}"/>
                                    <Slider x:Name="HapticsLeftAmp" Minimum="0" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnHapticsSettingsChanged"/>
                                    <Button Content="{DynamicResource PulseTest}" Margin="0,6,0,0" Click="OnHapticsLeftPulse"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{DynamicResource MotorRight}" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="HapticsRightWave" Margin="0,4,0,0" SelectionChanged="OnHapticsSettingsChanged">
                                        <ComboBoxItem Content="{DynamicResource WaveSine}"/>
                                        <ComboBoxItem Content="{DynamicResource WaveSquare}"/>
                                        <ComboBoxItem Content="{DynamicResource WavePulse}"/>
                                        <ComboBoxItem Content="{DynamicResource WaveNoise}"/>
                                    </ComboBox>
                                    <TextBlock Text="{DynamicResource FrequencyHz}"/>
                                    <Slider x:Name="HapticsRightFreq" Minimum="20" Maximum="500" Value="80" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnHapticsSettingsChanged"/>
                                    <TextBlock Text="{DynamicResource AmplitudePct}"/>
                                    <Slider x:Name="HapticsRightAmp" Minimum="0" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnHapticsSettingsChanged"/>
                                    <Button Content="{DynamicResource PulseTest}" Margin="0,6,0,0" Click="OnHapticsRightPulse"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupA2h}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource A2hDesc}" Foreground="Gray" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{DynamicResource Source}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="A2hSourceCombo" MinWidth="220" Margin="8,0,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="A2hEnable" Content="{DynamicResource EnableA2h}" Margin="0,8,0,0" Checked="OnA2hChecked" Unchecked="OnA2hUnchecked"/>
                            <TextBlock Text="{DynamicResource GainPct}" Margin="0,8,0,0"/>
                            <Slider x:Name="A2hGain" Minimum="0" Maximum="300" Value="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnA2hSettingsChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource Cutoff}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="A2hCutoff" Width="80" Margin="8,0,16,0" SelectionChanged="OnA2hSettingsChanged">
                                    <ComboBoxItem Content="80 Hz"/>
                                    <ComboBoxItem Content="160 Hz"/>
                                    <ComboBoxItem Content="250 Hz"/>
                                    <ComboBoxItem Content="400 Hz"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Mode}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="A2hMode" Width="110" Margin="8,0,0,0" SelectionChanged="OnA2hSettingsChanged">
                                    <ComboBoxItem Content="{DynamicResource ModeWaveform}"/>
                                    <ComboBoxItem Content="{DynamicResource ModeEnvelope}"/>
                                </ComboBox>
                                <CheckBox x:Name="A2hMonoMix" Content="{DynamicResource MonoMix}" VerticalAlignment="Center" Margin="16,0,0,0" Checked="OnA2hSettingsChanged" Unchecked="OnA2hSettingsChanged"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Gate}" Margin="0,6,0,0"/>
                            <Slider x:Name="A2hGate" Minimum="0" Maximum="50" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnA2hSettingsChanged"/>
                            <TextBlock Text="{DynamicResource Attack}"/>
                            <Slider x:Name="A2hAttack" Minimum="1" Maximum="50" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnA2hSettingsChanged"/>
                            <TextBlock Text="{DynamicResource Release}"/>
                            <Slider x:Name="A2hRelease" Minimum="20" Maximum="500" Value="150" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OnA2hSettingsChanged"/>
                            <TextBlock Text="{DynamicResource Carrier}"/>
                            <Slider x:Name="A2hCarrier" Minimum="40" Maximum="200" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnA2hSettingsChanged"/>
                            <TextBlock x:Name="A2hStatus" Margin="0,8,0,0" Foreground="Gray" FontFamily="Consolas" FontSize="11"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupVirtual}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="VirtualPadCheck" Content="{DynamicResource EnableVirtual}" Checked="OnVirtualPadChecked" Unchecked="OnVirtualPadUnchecked"/>
                            <CheckBox x:Name="GyroToStickCheck" Content="{DynamicResource GyroToStick}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="VirtualPadStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource GroupSettings}" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartCheck" Content="{DynamicResource AutoStart}" Checked="OnAutoStartChanged" Unchecked="OnAutoStartChanged"/>
                            <TextBlock Text="{DynamicResource TrayHint}" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Foreground="Gray" Text="{DynamicResource Ready}"/>
    </Grid>
</Window>
